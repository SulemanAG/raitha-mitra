# ===================================================================
# Raitha Mitra — Production & Environment Variable Reference
# ===================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT.
# Supply these environment variables in your deployment platform (e.g. Render Dashboard).

# -------------------------------------------------------------------
# Backend Spring Boot Configuration (Render Environment Variables)
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Neon PostgreSQL Connection Credentials
# Obtain JDBC connection details from your Neon Console (https://console.neon.tech)
DATABASE_URL=jdbc:postgresql://ep-example-pooler.region.aws.neon.tech:5432/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_neon_password_here

# JWT Signing Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=YourSuperSecureProductionJwtSecretKeyMustBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origin (Must match your deployed Render Frontend URL)
FRONTEND_ORIGIN=https://raitha-mitra-frontend.onrender.com

# Real SMS OTP Provider Configuration
OTP_PROVIDER_API_KEY=your_production_sms_api_key_here
OTP_PROVIDER_SENDER_ID=RAITHA
OTP_EXPIRATION_MINUTES=5

# -------------------------------------------------------------------
# Frontend React / Vite Configuration (Render Environment Variables)
# -------------------------------------------------------------------
# Public REST API Base URL for Client HTTP Fetch Calls
VITE_API_BASE_URL=https://raitha-mitra-backend.onrender.com/api/v1
